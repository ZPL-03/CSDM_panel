# -*- coding: utf-8 -*-
"""FEM_AGENT 生成的独立 CAE 进程入口。"""

import imp
import json
import os
import sys

# 求解进程不在项目源码目录写入字节码缓存。
sys.dont_write_bytecode = True

# CAE 的显示精度不能参与物理契约的 JSON 往返及指纹计算。
if sys.version_info[0] == 2:
    json.encoder.FLOAT_REPR = float.__repr__

ROOT = r"{{ project_root }}"
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

MODULE_PATH = os.path.join(ROOT, "abaqus", "runtime_build_panel.py")
runtime_module = imp.load_source("csdm_runtime_build_panel", MODULE_PATH)
runtime_module.build_panel(
    input_json=r"{{ input_json }}",
    result_json=r"{{ result_json }}",
)
